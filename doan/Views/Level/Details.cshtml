@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@using doan.Models

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Context
@inject IHttpContextAccessor HttpContextAccessor
@model doan.Models.Baihoc

@{
    var Diendanmodel = new Dictionary<string, string>();
    var user = await UserManager.GetUserAsync(User);
    var learnedIds = Context.UserVocabularyProgresses
        .Where(p => p.UserId == user.Id && p.IsLearned)
        .Select(p => p.VocabularyId)
        .ToHashSet();

    int totalWords = Model.tuvung.Count();
    int totalLearned = Model.tuvung.Count(w => learnedIds.Contains(w.Id));
    int pageSize = 5;
    int page = Convert.ToInt32(HttpContextAccessor.HttpContext?.Request.Query["page"].FirstOrDefault() ?? "1");
    var pagedWords = Model.tuvung.Skip((page - 1) * pageSize).Take(pageSize).ToList();
    int totalPages = (int)Math.Ceiling((double)totalWords / pageSize);

    int totalComments = Model.Diendan.Count();
    int commentPageSize = 4;
    int commentPage = Convert.ToInt32(HttpContextAccessor.HttpContext?.Request.Query["commentPage"].FirstOrDefault() ?? "1");
    var pagedComments = Model.Diendan.Skip((commentPage - 1) * commentPageSize).Take(commentPageSize).ToList();
    int totalCommentPages = (int)Math.Ceiling((double)totalComments / commentPageSize);
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<div class="container my-5 animate__animated animate__fadeIn">
    <h1 class="text-center text-primary fw-bold mb-5 display-5">
        📘 Bài học: <span class="text-dark">@Model.Name</span>
    </h1>

    <!-- Từ vựng -->
    <section class="mb-5">
        <h2 class="text-success fw-bold mb-3">📚 Từ vựng</h2>

        @if (pagedWords.Any())
        {
            <div class="table-responsive animate__fadeInUp">
                <table class="table table-bordered table-hover align-middle text-center shadow-sm">
                    <thead class="table-primary">
                        <tr>
                            <th>Từ</th>
                            <th>Phát âm</th>
                            <th>Âm Hán</th>
                            <th>Hán tự</th>
                            <th>Nghĩa</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var word in pagedWords)
                        {
                            <tr>
                                <td class="fw-semibold">@word.Tuvung</td>
                                <td>@(word.PhatAm ?? "-")</td>
                                <td>@(word.AmHan ?? "-")</td>
                                <td>@(word.HanTu ?? "-")</td>
                                <td>@word.Nghia</td>
                                <td>
                                    <form asp-controller="Learning" asp-action="@(learnedIds.Contains(word.Id) ? "MarkUnlearned" : "MarkLearned")" method="post">
                                        <input type="hidden" name="VocabId" value="@word.Id" />
                                        <button type="submit" class="btn btn-sm rounded-pill @(learnedIds.Contains(word.Id) ? "btn-warning" : "btn-outline-success")">
                                            @(learnedIds.Contains(word.Id) ? "🔁 Chưa học" : "✅ Đã học")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination for vocabulary -->
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <a class="page-link" href="?page=@i&commentPage=@commentPage">@i</a>
                        </li>
                    }
                </ul>
            </nav>

            <div class="text-end text-muted mt-2">
                📈 Đã học: <strong class="text-success">@totalLearned</strong> / <strong>@totalWords</strong> từ vựng.
            </div>
        }
        else
        {
            <div class="alert alert-warning mt-3">❌ Chưa có từ vựng cho bài học này.</div>
        }
    </section>

    <!-- Ngữ pháp -->
    <section class="mb-5">
        <h2 class="text-success fw-bold">📖 Ngữ pháp</h2>

        @if (Model.nguphap.Any())
        {
            <div class="table-responsive mt-3 animate__fadeInUp">
                <table class="table table-bordered table-hover align-middle text-center shadow-sm">
                    <thead class="table-success">
                        <tr>
                            <th>Công thức</th>
                            <th>Giải thích</th>
                            <th>Ví dụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.nguphap)
                        {
                            <tr>
                                <td class="fw-semibold">@g.CongThuc</td>
                                <td>@g.GiaiThich</td>
                                <td>@g.CauViDu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">⚠️ Chưa có dữ liệu ngữ pháp cho bài học này.</div>
        }
    </section>

    <!-- Diễn đàn -->
    <section class="mb-5">
        <h2 class="text-success fw-bold">🗣️ Diễn đàn</h2>

        @if (pagedComments.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 g-4 mt-3 animate__fadeInUp">
                @foreach (var post in pagedComments)
                {
                    <div class="col">
                        <div class="card border shadow-sm rounded-4 hover-shadow h-100">
                            <div class="card-body">
                                <h5 class="card-title text-primary">@post.TieuDe</h5>
                                <p class="card-text">@post.NoiDung</p>
                            </div>
                            <div class="card-footer bg-white text-end small text-muted border-top">
                                🧑 Người đăng: <strong>@(post.User?.Name ?? "Ẩn danh")</strong> | ⏰ @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>

         <!-- Pagination for comments -->
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int cmtPage = 1; cmtPage <= totalCommentPages; cmtPage++)
                    {
                        var href = $"?page={page}&commentPage={cmtPage}";
                        <li class="page-item @(cmtPage == commentPage ? "active" : "")">
                            <a class="page-link" href="@href">@cmtPage</a>
                        </li>
                    }
                </ul>
            </nav>


        }
        else
        {
            <div class="alert alert-secondary mt-3">💬 Chưa có bài viết nào được đăng.</div>
        }
    </section>

    <!-- Form đăng bài -->
    <section class="mb-5">
        <h2 class="text-success fw-bold">✍️ Đăng bài mới</h2>

        <form asp-action="DangBai" asp-controller="Lesson" method="post" class="p-4 mt-3 border rounded-4 shadow-sm bg-light animate__fadeInUp">
            <input type="hidden" name="BaiHocId" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">📝 Tiêu đề</label>
                <input type="text" name="TieuDe" class="form-control rounded-pill" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">📄 Nội dung</label>
                <textarea name="NoiDung" class="form-control" rows="4" required></textarea>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-success rounded-pill shadow-sm">🚀 Gửi bài viết</button>
            </div>
        </form>
    </section>

    <!-- Điều hướng -->
    <section class="text-center mt-5 animate__fadeIn">
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-controller="Home" asp-action="ChonLevel" class="btn btn-outline-primary rounded-pill">🔙 Chọn Level</a>
            <a asp-controller="Home" asp-action="Flashcards" asp-route-baiHocId="@Model.Id" class="btn btn-success rounded-pill">🎴 Flashcards</a>
            <a asp-controller="Learning" asp-action="Daily" class="btn btn-info rounded-pill">📘 Lộ Trình Hôm Nay</a>
            <a asp-controller="Learning" asp-action="LearnedWords" class="btn btn-secondary rounded-pill">📖 Từ đã học</a>
        </div>
    </section>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
        transition: all 0.3s ease;
    }
</style>

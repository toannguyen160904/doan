@model SharedModels.Models.ViewModels.LessonDetailsViewModel

@{
    ViewData["Title"] = Model?.Lesson?.Name ?? "Chi tiết bài học";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<!-- Hidden user ID để JS sử dụng -->
<input type="hidden" id="currentUserId" value="@userId" />
@Html.AntiForgeryToken()

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&display=swap" rel="stylesheet">

<div class="container my-5 animate__animated animate__fadeIn">
    @if (Model != null && Model.Lesson != null)
    {
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold mb-2">
                Bài học: <span class="text-primary">@Model.Lesson.Name</span>
            </h1>
        </div>

        <!-- Từ vựng -->
        <section class="mb-4">
            <div class="card section-card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h2 class="card-title h5 mb-0 fw-bold">
                        <i class="fas fa-book-open me-2 text-success"></i>Từ vựng
                    </h2>
                </div>
                <div class="card-body p-3">
                    @if (Model.PagedVocabularies != null && Model.PagedVocabularies.Any())
                    {
                        <div class="table-responsive">
                            <table id="new-words-table" class="table table-hover align-middle mb-0">
                                <thead class="table-light text-center">
                                    <tr>
                                        <th class="text-start">Từ</th>
                                        <th>Phát âm</th>
                                        <th>Âm Hán</th>
                                        <th>Hán tự</th>
                                        <th class="text-start">Nghĩa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var word in Model.PagedVocabularies)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-primary text-start">@word?.Tuvung</td>
                                            <td class="text-center">@word?.PhatAm</td>
                                            <td class="text-center">@word?.AmHan</td>
                                            <td class="text-center">@word?.HanTu</td>
                                            <td class="text-start ps-3">@word?.Nghia</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Phân trang từ vựng -->
                        <nav aria-label="Vocabulary pagination" class="mt-3">
                            <ul class="pagination justify-content-center mb-0">
                                @for (int i = 1; i <= Model.TotalVocabularyPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentVocabularyPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-controller="Lesson"
                                           asp-action="Details"
                                           asp-route-id="@Model.Lesson.Id"
                                           asp-route-page="@i"
                                           asp-route-commentPage="@Model.CurrentCommentPage">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                    else
                    {
                        <div class="alert alert-light text-center mb-0">❌ Chưa có từ vựng cho bài học này.</div>
                    }
                </div>
            </div>
        </section>

        <!-- Ngữ pháp -->
        <section class="mb-4">
            <div class="card section-card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h2 class="card-title h5 mb-0 fw-bold">
                        <i class="fas fa-pencil-ruler me-2 text-info"></i>Ngữ pháp
                    </h2>
                </div>
                <div class="card-body p-3">
                    @if (Model.Lesson.nguphap != null && Model.Lesson.nguphap.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-center">
                                    <tr>
                                        <th class="text-start">Công thức</th>
                                        <th class="text-start">Giải thích</th>
                                        <th class="text-start">Ví dụ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in Model.Lesson.nguphap)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-primary text-start">@g.CongThuc</td>
                                            <td class="text-start ps-3">@g.GiaiThich</td>
                                            <td class="text-start ps-3">@g.CauViDu</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light text-center mb-0">⚠️ Chưa có dữ liệu ngữ pháp cho bài học này.</div>
                    }
                </div>
            </div>
        </section>

        <!-- Diễn đàn -->
        <section class="mb-4">
            <div class="card section-card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h2 class="card-title h5 mb-0 fw-bold">
                        <i class="fas fa-comments me-2 text-primary"></i>Diễn đàn
                    </h2>
                </div>
                <div class="card-body p-3">
                    <div id="discussion-container">
                        <div class="row row-cols-1 row-cols-lg-2 g-3" id="discussion-list">
                            @if (Model.PagedComments != null && Model.PagedComments.Any())
                            {
                                @foreach (var post in Model.PagedComments)
                                {
                                    <div class="col discussion-item-@post.Id">
                                        <div class="card h-100 discussion-card border rounded-3 shadow-sm">
                                            <div class="card-body">
                                                <h5 class="card-title h6 fw-bold text-primary mb-1">@post.TieuDe</h5>
                                                <p class="card-text small">@post.NoiDung</p>
                                            </div>
                                            <div class="card-footer bg-transparent border-top-0 pt-0 text-end">
                                                <small class="text-muted">
                                                    <strong>@(post.User?.Name ?? "Ẩn danh")</strong> - @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-light text-center" id="no-comments-alert">💬 Chưa có bài viết nào được đăng.</div>
                            }
                        </div>

                        <!-- Phân trang bình luận -->
                        <nav aria-label="Comment pagination" class="mt-3">
                            <ul class="pagination justify-content-center mb-0">
                                @for (int i = 1; i <= Model.TotalCommentPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentCommentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-controller="Lesson"
                                           asp-action="Details"
                                           asp-route-id="@Model.Lesson.Id"
                                           asp-route-page="@Model.CurrentVocabularyPage"
                                           asp-route-commentPage="@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>

                    <!-- Form bình luận -->
                    <div class="mt-4 pt-4 border-top">
                        <form id="comment-form" action="/Lesson/DangBai" method="post">
                            <input type="hidden" name="BaiHocId" value="@Model.Lesson.Id" />
                            <div class="input-group">
                                <textarea id="comment-content" name="NoiDung" class="form-control" rows="1" placeholder="Thêm bình luận..." required style="resize: none;"></textarea>
                                <button id="submit-comment-btn" class="btn btn-primary" type="submit">
                                    <i class="fas fa-paper-plane"></i> Gửi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- Nút điều hướng -->
        <section class="text-center my-4">
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-controller="Home" asp-action="ChonLevel" class="btn btn-outline-secondary rounded-pill">🔙 Quay lại</a>
                <a asp-controller="Home" asp-action="Flashcards" asp-route-baiHocId="@Model.Lesson.Id" class="btn btn-success rounded-pill">🎴 Flashcards</a>
                <a asp-controller="Learning" asp-action="Daily" class="btn btn-info rounded-pill">📘 Lộ Trình Hôm Nay</a>
                <a asp-controller="Learning" asp-action="LearnedWords" class="btn btn-dark rounded-pill">📖 Từ đã học</a>
            </div>
        </section>
    }
    else
    {
        <div class="text-center">
            <h1 class="display-4">Lỗi</h1>
            <p class="lead">Không thể tải dữ liệu bài học.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Trang chủ</a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/lesson-details.js" asp-append-version="true"></script>
}

@model List<doan.Models.Vocabulary>
@{
    ViewData["Title"] = "Từ Đã Học";
}
<div class="container py-4">
    <h2 class="mb-4 text-primary">✅ Danh sách từ đã học</h2>

    <a asp-action="Daily" class="btn btn-secondary mb-3">⬅️ Quay lại lộ trình hôm nay</a>

    <table class="table table-bordered table-striped">
        <thead class="table-light text-center">
            <tr>
                <th>#</th>
                <th>Từ</th>
                <th>Nghĩa</th>
                <th>Ngày tạo</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var word in Model)
            {
                <tr class="text-center">
                    <td>@word.Id</td>
                    <td>@word.Tuvung</td>
                    <td>@word.Nghia</td>
                    <td>@word.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <form asp-action="MarkUnlearned" method="post">
                            <input type="hidden" name="VocabId" value="@word.Id" />
                            <button type="submit" class="btn btn-warning btn-sm">Đánh dấu chưa học</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model List<doan.Models.Vocabulary>
@{
    ViewData["Title"] = "Từ Đã Học";
}
<div class="container py-4">
    <h2 class="mb-4 text-primary fw-semibold">✅ Danh sách từ đã học</h2>

    <a asp-action="Daily" class="btn btn-outline-secondary mb-4 rounded-pill px-4">⬅️ Quay lại lộ trình hôm nay</a>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th class="text-secondary">#</th>
                    <th class="text-secondary">Từ</th>
                    <th class="text-secondary">Nghĩa</th>
                    <th class="text-secondary">Ngày tạo</th>
                    <th class="text-secondary">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var word in Model)
                {
                    <tr class="text-center">
                        <td class="fw-bold text-muted">@word.Id</td>
                        <td class="fw-semibold text-dark">@word.Tuvung</td>
                        <td class="text-secondary">@word.Nghia</td>
                        <td class="text-secondary">@word.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <form asp-action="MarkUnlearned" method="post" class="d-inline">
                                <input type="hidden" name="VocabId" value="@word.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3">🔄 Chưa học</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

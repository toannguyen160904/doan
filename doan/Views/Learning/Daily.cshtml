@using SharedModels.Models
@using SharedModels.Models.ViewModels
@model DailyLearningViewModel

@{
    ViewData["Title"] = "Lộ Trình Học Hôm Nay";

    var percent = Model.DailyTarget > 0
        ? (int)((double)Model.CompletedToday / Model.DailyTarget * 100)
        : 0;
}

<div class="container py-5">
    <h2 class="fw-bold mb-4 text-primary">📘 Lộ Trình Học Hôm Nay</h2>

    @if (Model.CompletedToday >= Model.DailyTarget)
    {
        <div class="alert alert-success">🎉 Chúc mừng bạn đã hoàn thành lộ trình hôm nay!</div>
    }
    else
    {
        <div class="alert alert-warning">⏳ Bạn còn <strong>@(Model.DailyTarget - Model.CompletedToday)</strong> từ để hoàn thành hôm nay!</div>
    }

    <div class="mb-4">
        <div class="d-flex justify-content-between">
            <span><strong>🎯 Tiến độ hôm nay:</strong> @Model.CompletedToday / @Model.DailyTarget từ</span>
            <span class="text-muted">@percent%</span>
        </div>
        <div class="progress" style="height: 20px;">
            <div class="progress-bar bg-success" role="progressbar"
                 style="width: @percent%" aria-valuenow="@percent"
                 aria-valuemin="0" aria-valuemax="100">
                @percent%
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm">
            <thead class="table-light text-center">
                <tr>
                    <th>#</th>
                    <th>Từ</th>
                    <th>Nghĩa</th>
                    <th>Trạng thái</th>
                    <th>Ngày ôn tập</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.NewWords)
                {
                    var isLearned = Model.LearnedIds.Contains(item.Id);
                    <tr class="text-center">
                        <td>@item.Id</td>
                        <td>@item.Tuvung</td>
                        <td>@item.Nghia</td>
                        <td>
                            @if (isLearned)
                            {
                                <span class="badge bg-success">✅ Đã học</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">❌ Chưa học</span>
                            }
                        </td>
                        <td>@(item.CreatedAt.ToString("dd/MM/yyyy") ?? "Chưa có lịch")</td>
                        <td>
                            <form asp-action="@(isLearned ? "MarkUnlearned" : "MarkLearned")" method="post">
                                <input type="hidden" name="VocabId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm @(isLearned ? "btn-warning" : "btn-success")">
                                    @(isLearned ? "Đánh dấu chưa học" : "Đánh dấu đã học")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.ReviewWords.Any())
    {
        <div class="mt-5">
            <h3 class="text-warning">🔁 Từ cần ôn lại hôm nay (Spaced Repetition)</h3>
            <table class="table table-bordered">
                <thead class="table-light text-center">
                    <tr>
                        <th>Từ</th>
                        <th>Nghĩa</th>
                        <th>Hán tự</th>
                        <th>Âm Hán</th>
                        <th>Ngày học</th>
                        <th>Ngày ôn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ReviewWords)
                    {
                        <tr class="table-warning text-center">
                            <td>@item.Vocabulary.Tuvung</td>
                            <td>@item.Vocabulary.Nghia</td>
                            <td>@item.Vocabulary.HanTu</td>
                            <td>@item.Vocabulary.AmHan</td>
                            <td>@item.LearnedDate?.ToString("dd/MM/yyyy")</td>
                            <td>@item.NextReviewDate?.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Home" asp-action="ChonLevel" class="btn btn-outline-primary rounded-pill mt-4">🔙 Chọn Level</a>
</div>

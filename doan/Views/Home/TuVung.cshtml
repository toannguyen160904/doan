@model IEnumerable<doan.Models.Vocabulary>

@{
    ViewData["Title"] = "Từ vựng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-4">📘 Danh sách từ vựng</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có từ vựng nào được tìm thấy.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Từ vựng</th>
                <th>Phát âm</th>
                <th>Hán tự</th>
                <th>Âm Hán</th>
                <th>Nghĩa</th>
                <th>Bài học</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Tuvung</td>
                    <td>@item.PhatAm</td>
                    <td>@item.HanTu</td>
                    <td>@item.AmHan</td>
                    <td>@item.Nghia</td>
                    <td>@item.Lesson?.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-gray-100">
    <div class="container mx-auto p-4">
        <!-- Header -->
        <div class="bg-white shadow-md p-4 rounded-lg">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-4">
                    <a href="/" class="text-xl font-bold text-blue-600 flex items-center">
                        <i class="fas fa-home mr-2"></i> Trang chủ
                    </a>
                    <a href="/Home/ChonLevel" class="text-lg text-blue-500 hover:underline">Cấp độ</a>
                </div>
            </div>
        </div>

        <!-- Banner -->
        <div class="flex justify-center my-8">
            <div class="w-full md:w-2/3 text-center">
                <h2 class="text-2xl font-semibold text-gray-700">Học tiếng Nhật từ N5 - N3</h2>
                <img class="w-full h-auto rounded-lg shadow-md mt-4"
                     src="https://storage.googleapis.com/a1aa/image/HvB8j3VnQT2z-zM3fnxjnxOD0kXS8xjRIVLylkLMTPU.jpg" />
                <a href="/Home/ChonLevel"
                   class="mt-4 inline-block bg-blue-500 text-white px-6 py-2 rounded-lg text-lg font-semibold hover:bg-blue-600 transition">
                    Bắt đầu học ngay!
                </a>
            </div>
        </div>

        <!-- Danh sách bài học -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Học từ vựng -->
            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center">
                <h2 class="text-xl font-semibold text-gray-700">📚 Học từ vựng</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3"
                     src="https://storage.googleapis.com/a1aa/image/g_muQKQU5q0Nofanks7MBs04BIVohhWF_FfsWE5iJdc.jpg" />
                <div class="mt-3">
                    <a href="/Home/ChonLevel" class="block text-blue-500 text-lg font-semibold hover:underline">
                        Học từ vựng (N5)
                    </a>
                    <a href="/Home/ChonLevel" class="block text-blue-500 text-lg font-semibold hover:underline">
                        Học từ vựng (N4)
                    </a>
                    <a href="/Home/ChonLevel" class="block text-blue-500 text-lg font-semibold hover:underline">
                        Học từ vựng (N3)
                    </a>
                </div>
            </div>

            <!-- Học ngữ pháp -->
            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center">
                <h2 class="text-xl font-semibold text-gray-700">📖 Học ngữ pháp</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3"
                     src="https://storage.googleapis.com/a1aa/image/wnOhn2QS1Hkf3N5eoQxXj1LEOTqB4lSPQ6b9JuVM9Wk.jpg" />
                <div class="mt-3">
                    <a href="/Home/ChonLevel" class="block text-blue-500 text-lg font-semibold hover:underline">
                        Học ngữ pháp (N5)
                    </a>
                    <a href="/Home/ChonLevel" class="block text-blue-500 text-lg font-semibold hover:underline">
                        Học ngữ pháp (N4)
                    </a>
                    <a href="/Home/ChonLevel" class="block text-blue-500 text-lg font-semibold hover:underline">
                        Học ngữ pháp (N3)
                    </a>
                </div>
            </div>

            <!-- MiniTest -->
            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center">
                <h2 class="text-xl font-semibold text-gray-700">📝 Học MiniTest</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3"
                     src="https://storage.googleapis.com/a1aa/image/KMhXzNrEOBei-JTV3u_87_HMhtOVUtkrUEvCUPZDeng.jpg" />
                <a href="/Home/MiniTest" class="mt-3 block text-blue-500 text-lg font-semibold hover:underline">
                    Click vào đây
                </a>
            </div>
        </div>
    </div>
</body>

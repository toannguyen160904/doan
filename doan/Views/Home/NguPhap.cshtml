@model IEnumerable<doan.Models.GrammarStructure>

@{
    ViewData["Title"] = "Học ngữ pháp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-3">📘 Danh sách cấu trúc ngữ pháp</h2>

<table class="table table-bordered table-striped mt-4">
    <thead class="table-dark">
        <tr>
            <th>Công thức</th>
            <th>Giải thích</th>
            <th>Câu ví dụ</th>
            <th>Bài học</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.CongThuc</td>
                    <td>@item.GiaiThich</td>
                    <td>@item.CauViDu</td>
                    <td>@item.Lesson?.Name</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Không có dữ liệu ngữ pháp.</td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">← Quay lại Trang chủ</a>

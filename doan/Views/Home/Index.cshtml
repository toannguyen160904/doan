@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script>
        function searchDocuments() {
            var input = document.getElementById('searchInput').value.toLowerCase();
            var lessons = document.getElementsByClassName('lesson-item');

            for (var i = 0; i < lessons.length; i++) {
                var lesson = lessons[i];
                var title = lesson.getAttribute('data-title').toLowerCase();
                lesson.style.display = title.includes(input) ? "" : "none";
            }
        }

        function clearSearch() {
            document.getElementById('searchInput').value = "";
            searchDocuments();
        }

        function toggleMenu() {
            document.getElementById("menuDropdown").classList.toggle("hidden");
        }
    </script>

    <script src="https://unpkg.com/sakura-js/dist/sakura.min.js"></script>
    <script src="~/js/index.js" asp-append-version="true"></script>

</head>

<body class="bg-gray-100">

    <!-- Loader -->
    <div id="loader" class="fixed inset-0 bg-white flex justify-center items-center z-50">
        <div class="animate-spin rounded-full h-20 w-20 border-t-4 border-blue-500"></div>
    </div>

    <div class="container mx-auto p-4">

        <!-- Header -->
        <div class="bg-white shadow-md p-4 rounded-lg">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-4">
                    <a href="/" class="text-xl font-bold text-blue-600 flex items-center">
                        <i class="fas fa-home mr-2"></i> Trang chủ
                    </a>
                    <a href="/Home/ChonLevel" class="text-lg text-blue-500 hover:underline">Cấp độ</a>

                    <a href="/Learning/Daily" class="text-lg text-blue-500 hover:underline">Lộ Trình Học</a>


                </div>

                <button class="text-gray-600 text-2xl focus:outline-none" onclick="toggleMenu()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>


            <!-- Menu dropdown -->
            <div id="menuDropdown" class="hidden mt-4 bg-gray-100 p-3 rounded-lg shadow-lg">
                <ul class="space-y-2 text-center">
                    <li><a href="/" class="block text-lg text-blue-600 hover:underline">🏠 Trang chủ</a></li>
                    <li><a href="/Home/ChonLevel" class="block text-lg text-blue-600 hover:underline">📚 Chọn cấp độ</a></li>
                    <li><a href="/Learning/Daily" class="block text-lg text-blue-600 hover:underline">📈 Lộ Trình Học</a></li>
                    <li><a href="/Home/Privacy" class="block text-lg text-blue-600 hover:underline">🔒 Chính sách</a></li>

            <div id="menuDropdown" class="hidden mt-4 bg-white border border-gray-300 p-4 rounded-lg shadow-lg">
                <ul class="space-y-3 text-center">
                    <li><a href="/" class="block py-2 text-gray-700 hover:text-blue-600">🏠 Trang chủ</a></li>
                    <li><a href="/Home/ChonLevel" class="block py-2 text-gray-700 hover:text-blue-600">📚 Chọn cấp độ</a></li>
                    <li><a href="/Home/Privacy" class="block py-2 text-gray-700 hover:text-blue-600">🔒 Chính sách</a></li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="block py-2 text-gray-700 hover:text-blue-600">🛠️ Admin</a></li>
                    }

                    <li><hr class="my-2 border-gray-300"></li>

                    <li>
                        <div class="text-gray-500 text-sm mb-1 uppercase tracking-widest text-center">Tài khoản</div>
                        <div class="flex justify-center"><partial name="_LoginPartial" /></div>
                    </li>

                </ul>
            </div>
        </div>

        <!-- Banner Giới thiệu Pro -->
        <div class="flex justify-center my-14">
            <div class="w-full md:w-4/5 bg-gradient-to-r from-blue-100 to-blue-50 p-10 rounded-2xl shadow-2xl flex flex-col md:flex-row items-center border border-blue-200 gap-8">

                <!-- Nội dung -->
                <div class="md:w-1/2 text-center md:text-left space-y-6 animate-fadeInUp">
                    <h1 class="text-4xl md:text-5xl font-extrabold leading-tight text-blue-700">
                        <span class="typing"></span>
                    </h1>

                    <p class="text-gray-600 text-lg leading-relaxed">
                        Cùng bạn chinh phục tiếng Nhật một cách dễ dàng, hiệu quả và hoàn toàn miễn phí.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-700 text-base">
                        <div class="flex items-center"><i class="fas fa-check-circle text-green-500 mr-2"></i> Nội dung chuẩn JLPT</div>
                        <div class="flex items-center"><i class="fas fa-laptop-code text-blue-500 mr-2"></i> Học Online dễ hiểu</div>
                        <div class="flex items-center"><i class="fas fa-users text-blue-500 mr-2"></i> Phù hợp mọi trình độ</div>
                        <div class="flex items-center"><i class="fas fa-mobile-alt text-blue-500 mr-2"></i> Học mọi lúc mọi nơi</div>
                    </div>

                    <a href="/Home/ChonLevel"
                       class="inline-block bg-gradient-to-r from-pink-500 to-blue-500 text-white px-8 py-3 rounded-full text-lg font-semibold hover:scale-105 hover:shadow-[0_0_20px_#60a5fa] transition duration-300">
                        BẮT ĐẦU HỌC NGAY
                    </a>
                </div>

                <div class="hidden md:block w-[1px] h-[280px] bg-blue-200"></div>

                <!-- Hình ảnh -->
                <div class="md:w-1/2 text-center animate-fadeIn">
                    <img src="https://lophoctiengnhat.edu.vn/images/2017/04/19/hoc-tieng-nhat.jpg"
                         class="w-[320px] mx-auto rounded-3xl border-4 border-blue-100 drop-shadow-xl">
                </div>

            </div>
        </div>

        <!-- Test đầu vào -->
        <div class="flex justify-center mb-8">
            <div class="w-full md:w-2/3 bg-gradient-to-r from-purple-600 to-indigo-600 text-white p-6 rounded-xl shadow-lg text-center">
                <h3 class="text-2xl font-bold mb-2">🎯 Test đầu vào</h3>
                <p class="mb-4 text-lg">Làm bài kiểm tra để đánh giá trình độ và nhận lộ trình học cá nhân hoá</p>
                <a href="/Test/Start" class="inline-block bg-white text-indigo-600 px-5 py-2 rounded-lg font-semibold hover:bg-gray-100 transition">
                    Bắt đầu bài kiểm tra
                </a>
            </div>
        </div>

        <!-- Danh sách học phần -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center">
                <h2 class="text-xl font-semibold text-gray-700">Học từ vựng</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3" src="https://storage.googleapis.com/a1aa/image/g_muQKQU5q0Nofanks7MBs04BIVohhWF_FfsWE5iJdc.jpg" />
                <a href="/Home/Chonlevel" class="mt-3 block text-blue-500 text-lg font-semibold hover:underline">Click vào đây</a>
            </div>

            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center">
                <h2 class="text-xl font-semibold text-gray-700">Học ngữ pháp</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3" src="https://storage.googleapis.com/a1aa/image/wnOhn2QS1Hkf3N5eoQxXj1LEOTqB4lSPQ6b9JuVM9Wk.jpg" />
                <a href="/Home/Chonlevel" class="mt-3 block text-blue-500 text-lg font-semibold hover:underline">Click vào đây</a>
            </div>

            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center">
                <h2 class="text-xl font-semibold text-gray-700">Học MiniTest</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3" src="https://storage.googleapis.com/a1aa/image/KMhXzNrEOBei-JTV3u_87_HMhtOVUtkrUEvCUPZDeng.jpg" />
                <a href="/Home/MiniTest" class="mt-3 block text-blue-500 text-lg font-semibold hover:underline">Click vào đây</a>
            </div>
        </div>

        <!-- Footer -->

    </div>

    <!-- Nút scroll lên đầu trang -->
    <button onclick="window.scrollTo({top:0,behavior:'smooth'})"
            class="fixed bottom-6 right-6 bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-full shadow-lg text-xl z-50">
        ↑
    </button>


</body>

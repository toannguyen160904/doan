@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-gradient-to-tr from-indigo-50 via-white to-pink-50 min-h-screen font-sans">

    <!-- Loader -->
    <div id="loader" class="fixed inset-0 bg-white flex justify-center items-center z-50">
        <div class="animate-spin rounded-full h-20 w-20 border-t-4 border-indigo-500"></div>
    </div>

    <div class="container mx-auto px-4 py-6">
        <!-- Header -->
        <div class="bg-white shadow-md p-5 rounded-2xl flex justify-between items-center">
            <a href="/" class="text-2xl font-extrabold text-indigo-600 flex items-center">
                <i class="fas fa-home mr-2"></i> Nhật Ngữ 
            </a>
            <button onclick="toggleMenu()" class="text-2xl text-gray-600"><i class="fas fa-bars"></i></button>
        </div>

        <!-- Menu Dropdown -->
        <div id="menuDropdown" class="hidden mt-3 bg-white rounded-xl shadow-lg p-4">
            <ul class="space-y-2 text-lg text-center">
                <li><a href="/" class="hover:text-indigo-600">🏠 Trang chủ</a></li>
                <li><a href="/Home/ChonLevel" class="hover:text-indigo-600">📚 Chọn cấp độ</a></li>
                <li><a href="/Learning/Daily" class="hover:text-indigo-600">📈 Lộ trình học</a></li>
                <li><a href="/Test/Start" class="hover:text-indigo-600">🎯 Test đầu vào</a></li>
                <li><a href="/TuDien" class="hover:text-indigo-600">📖 Từ điển</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li><a asp-area="Admin" asp-controller="Lessons" asp-action="Index" class="hover:text-indigo-600">🛠️ Quản trị</a></li>
                }
                <li class="border-t pt-2 text-sm text-gray-500">Tài khoản</li>
                <li><div class="flex justify-center"><partial name="_LoginPartial" /></div></li>
            </ul>
        </div>

        <!-- Banner Hero -->
        <div class="mt-10 bg-white rounded-3xl shadow-2xl p-8 flex flex-col md:flex-row items-center gap-10 border border-indigo-200">
            <div class="md:w-1/2 space-y-5 text-center md:text-left">
                <h1 class="text-4xl md:text-5xl font-extrabold text-indigo-700 leading-tight">
                    <span class="typing"></span>
                </h1>
                <p class="text-gray-600 text-lg">
                    Cùng bạn chinh phục tiếng Nhật dễ dàng, hiệu quả và hoàn toàn miễn phí.
                </p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-gray-700">
                    <li><i class="fas fa-check-circle text-green-500 mr-2"></i> Chuẩn JLPT</li>
                    <li><i class="fas fa-globe text-blue-500 mr-2"></i> Học online</li>
                    <li><i class="fas fa-user text-purple-500 mr-2"></i> Mọi trình độ</li>
                    <li><i class="fas fa-mobile text-pink-500 mr-2"></i> Học mọi lúc</li>
                </ul>
                <a href="/Home/ChonLevel"
                   class="inline-block bg-gradient-to-r from-pink-500 to-indigo-500 text-white px-8 py-3 rounded-full text-lg font-semibold hover:scale-105 transition shadow-lg">
                    🚀 BẮT ĐẦU HỌC NGAY
                </a>
            </div>
            <div class="md:w-1/2">
                <img src="https://lophoctiengnhat.edu.vn/images/2017/04/19/hoc-tieng-nhat.jpg"
                     class="rounded-2xl shadow-lg border-4 border-indigo-100 mx-auto w-[300px] md:w-[360px]">
            </div>
        </div>

        <!-- Test đầu vào -->
        <div class="mt-12 text-center">
            <div class="bg-gradient-to-r from-purple-500 to-indigo-500 text-white p-6 rounded-xl shadow-xl">
                <h3 class="text-2xl font-bold mb-2">🎯 Làm bài kiểm tra đầu vào</h3>
                <p class="mb-4">Tìm ra trình độ phù hợp và nhận lộ trình học cá nhân hóa</p>
                <a href="/Test/Start" class="bg-white text-indigo-600 px-6 py-2 rounded-full font-semibold hover:bg-gray-100 transition">
                    BẮT ĐẦU NGAY
                </a>
            </div>
        </div>

        <!-- Danh sách học phần -->
        <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="lesson-item bg-white p-5 rounded-xl shadow hover:shadow-xl transition text-center" data-title="Học từ vựng">
                <h2 class="text-xl font-bold text-indigo-700 mb-3">📘 Học từ vựng</h2>
                <img src="https://storage.googleapis.com/a1aa/image/g_muQKQU5q0Nofanks7MBs04BIVohhWF_FfsWE5iJdc.jpg"
                     class="rounded-lg mb-4 w-full h-auto shadow-md" />
                <a href="/Home/ChonLevel" class="text-indigo-500 font-semibold hover:underline">Bắt đầu học</a>
            </div>

            <div class="lesson-item bg-white p-5 rounded-xl shadow hover:shadow-xl transition text-center" data-title="Học ngữ pháp">
                <h2 class="text-xl font-bold text-indigo-700 mb-3">📝 Minitest & Quiz</h2>
                <img src="https://png.pngtree.com/element_our/20190603/ourlarge/pngtree-little-boy-illustration-for-exam-image_1445842.jpg"
                     class="rounded-lg mb-4 w-full h-auto shadow-md" />
                <a href="/Home/DanhSachQuiz" class="text-indigo-500 font-semibold hover:underline">Làm bài tập</a>
            </div>

            <div class="lesson-item bg-white p-5 rounded-xl shadow hover:shadow-xl transition text-center" data-title="Từ điển">
                <h2 class="text-xl font-bold text-indigo-700 mb-3">📖 Từ điển</h2>
                <img src="https://storage.googleapis.com/a1aa/image/wnOhn2QS1Hkf3N5eoQxXj1LEOTqB4lSPQ6b9JuVM9Wk.jpg"
                     class="rounded-lg mb-4 w-full h-auto shadow-md" />
                <a href="/TuDien" class="text-indigo-500 font-semibold hover:underline">Tra cứu ngay</a>
            </div>
        </div>

        <!-- Scroll to top button -->
        <button onclick="scrollToTop()" class="fixed bottom-6 right-6 bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-full shadow-lg text-xl z-50">
            ↑
        </button>
    </div>

    <!-- Sakura + loader + typing effect -->
    <script src="https://unpkg.com/sakura-js/dist/sakura.min.js"></script>
    <script>
        function toggleMenu() {
            document.getElementById("menuDropdown").classList.toggle("hidden");
        }

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Sakura rơi
        window.addEventListener('DOMContentLoaded', function () {
            new Sakura('body', {
                fallSpeed: 1,
                className: 'sakura'
            });
        });

        // Typing Effect
        const text = "Hành Trình Học Tiếng Nhật N5 → N3 Dễ Dàng & Hiệu Quả";
        let i = 0;
        function typeEffect() {
            if (i < text.length) {
                document.querySelector('.typing').innerHTML += text.charAt(i);
                i++;
                setTimeout(typeEffect, 50);
            }
        }

        window.onload = function () {
            typeEffect();
            document.getElementById('loader').style.display = 'none';
        }
    </script>
</body>

@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Function to search documents by title
        function searchDocuments() {
            var input = document.getElementById('searchInput').value.toLowerCase();
            var lessons = document.getElementsByClassName('lesson-item');

            for (var i = 0; i < lessons.length; i++) {
                var lesson = lessons[i];
                var title = lesson.getAttribute('data-title').toLowerCase();

                if (title.includes(input)) {
                    lesson.style.display = "";
                } else {
                    lesson.style.display = "none";
                }
            }
        }

        // Function to clear the search input
        function clearSearch() {
            document.getElementById('searchInput').value = "";
            searchDocuments();
        }

        // Function to toggle the dropdown menu visibility
        function toggleMenu() {
            document.getElementById("menuDropdown").classList.toggle("hidden");
        }
    </script>
</head>

<body class="bg-gray-100">
    <div class="container mx-auto p-4">
        <!-- Header -->
        <div class="bg-white shadow-md p-4 rounded-lg">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-4">
                    <a href="/" class="text-xl font-bold text-blue-600 flex items-center">
                        <i class="fas fa-home mr-2"></i> Trang chủ
                    </a>
                    <a href="/Home/ChonLevel" class="text-lg text-blue-500 hover:underline">Cấp độ</a>
                    <a href="/Learning/Daily" class="text-lg text-blue-500 hover:underline">Lộ Trình Học</a> <!-- Thêm "Lộ Trình Học" -->
                </div>

                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <input type="text" id="searchInput" class="w-full p-2 pl-3 pr-10 border rounded-lg shadow-sm focus:ring focus:ring-blue-300"
                               placeholder="Tìm kiếm bài học..." onkeyup="searchDocuments()">
                        <i class="fas fa-times absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 cursor-pointer hover:text-black"
                           onclick="clearSearch()"></i>
                    </div>

                    <button class="text-gray-600 text-2xl focus:outline-none" onclick="toggleMenu()">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>

            <!-- Menu dropdown -->
            <div id="menuDropdown" class="hidden mt-4 bg-gray-100 p-3 rounded-lg shadow-lg">
                <ul class="space-y-2 text-center">
                    <li><a href="/" class="block text-lg text-blue-600 hover:underline">🏠 Trang chủ</a></li>
                    <li><a href="/Home/ChonLevel" class="block text-lg text-blue-600 hover:underline">📚 Chọn cấp độ</a></li>
                    <li><a href="/Learning/Daily" class="block text-lg text-blue-600 hover:underline">📚 Lộ Trình Học</a></li> <!-- Thêm "Lộ Trình Học" -->
                    <li><a href="/Home/Privacy" class="block text-lg text-blue-600 hover:underline">🔒 Chính sách</a></li>
                </ul>
            </div>
        </div>

        <!-- Banner -->
        <div class="flex justify-center my-8">
            <div class="w-full md:w-2/3 text-center">
                <h2 class="text-2xl font-semibold text-gray-700">Học tiếng Nhật từ N5 - N3</h2>
                <img class="w-full h-auto rounded-lg shadow-md mt-4"
                     src="https://storage.googleapis.com/a1aa/image/HvB8j3VnQT2z-zM3fnxjnxOD0kXS8xjRIVLylkLMTPU.jpg" />
                <a href="/Home/ChonLevel"
                   class="mt-4 inline-block bg-blue-500 text-white px-6 py-2 rounded-lg text-lg font-semibold hover:bg-blue-600 transition">
                    Bắt đầu học ngay!
                </a>
            </div>
        </div>

        <!-- Danh sách bài học -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center" data-title="Học từ vựng">
                <h2 class="text-xl font-semibold text-gray-700">Học từ vựng</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3"
                     src="https://storage.googleapis.com/a1aa/image/g_muQKQU5q0Nofanks7MBs04BIVohhWF_FfsWE5iJdc.jpg" />
                <a href="/Home/Chonlevel" class="mt-3 block text-blue-500 text-lg font-semibold hover:underline">
                    Click vào đây
                </a>
            </div>

            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center" data-title="Học ngữ pháp">
                <h2 class="text-xl font-semibold text-gray-700">Học ngữ pháp</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3"
                     src="https://storage.googleapis.com/a1aa/image/wnOhn2QS1Hkf3N5eoQxXj1LEOTqB4lSPQ6b9JuVM9Wk.jpg" />
                <a href="/Home/Chonlevel" class="mt-3 block text-blue-500 text-lg font-semibold hover:underline">
                    Click vào đây
                </a>
            </div>

            <div class="lesson-item bg-white p-4 rounded-lg shadow-md text-center" data-title="Học MiniTest">
                <h2 class="text-xl font-semibold text-gray-700">Học MiniTest</h2>
                <img class="w-full h-auto rounded-lg shadow-sm mt-3"
                     src="https://storage.googleapis.com/a1aa/image/KMhXzNrEOBei-JTV3u_87_HMhtOVUtkrUEvCUPZDeng.jpg" />
                <a href="/Home/MiniTest" class="mt-3 block text-blue-500 text-lg font-semibold hover:underline">
                    Click vào đây
                </a>
            </div>
        </div>
    </div>
</body>

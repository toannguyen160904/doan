@model List<doan.Models.TestQuestion>

@{
    Layout = "~/Areas/Admin/Views/Shared/_TestLayout.cshtml";
    ViewData["Title"] = "Làm bài kiểm tra đầu vào";
    var totalQuestions = Model.Count;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&display=swap" rel="stylesheet">


<div class="container py-5 quiz-container">
    <div class="quiz-header text-center mb-4">
        <h2 class="fw-bold text-primary">@ViewData["Title"]</h2>
        <p class="text-muted">Hãy hoàn thành bài kiểm tra để chúng tôi đề xuất lộ trình phù hợp nhất cho bạn.</p>
    </div>

    <!-- Thanh tiến trình -->
    <div class="progress mb-4" style="height: 10px;">
        <div id="test-progress-bar"
             class="progress-bar bg-success"
             role="progressbar"
             style="width: 0%"
             aria-valuenow="0"
             aria-valuemin="0"
             aria-valuemax="@totalQuestions"
             data-total-questions="@totalQuestions">
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-lg-5">
            <form id="testForm" asp-controller="Test" asp-action="Submit" method="post">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var question = Model[i];
                    <div class="quiz-question-card mb-5">
                        <h5 class="question-title fw-bold mb-3">
                            Câu @(i + 1): @question.QuestionText
                        </h5>

                        <div class="answer-options row g-3">
                            @for (int j = 0; j < question.Choices.Count; j++)
                            {
                                var choiceText = question.Choices[j];
                                <div class="form-check-wrapper col-md-6">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="answers[@i].SelectedAnswer"
                                           value="@j"
                                           id="Answer_@(i)_@(j)"
                                           required />
                                    <label class="quiz-option" for="Answer_@(i)_@(j)">
                                        @choiceText
                                    </label>
                                </div>
                            }
                        </div>
                        <input type="hidden" name="answers[@i].QuestionId" value="@question.Id" />
                    </div>
                }
                <div class="text-center mt-5">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow px-5">
                        <i class="bi bi-send-check-fill me-2"></i>Hoàn thành & Xem kết quả
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
        font-family: 'Be Vietnam Pro', sans-serif;
    }

    .quiz-container {
        max-width: 800px;
    }

    .question-title {
        color: #343a40;
    }

    .quiz-option {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        height: 100%;
        padding: 1rem;
        background-color: #fff;
        border: 2px solid #e9ecef;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        font-weight: 500;
    }

        .quiz-option:hover {
            border-color: #0d6efd;
            background-color: #e7f1ff;
        }

    .form-check-wrapper .form-check-input {
        display: none;
    }

        .form-check-wrapper .form-check-input:checked + .quiz-option {
            border-color: #0d6efd;
            background-color: #0d6efd;
            color: #fff;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        }
</style>

@section Scripts {
    <script src="~/js/test-handler.js" defer></script>
    <script src="~/js/test-ui.js" defer></script>
}
@model List<doan.Models.TestQuestion>

@{
    Layout = "~/Areas/Admin/Views/Shared/_TestLayout.cshtml";
    ViewData["Title"] = "Làm bài kiểm tra đầu vào";
}

<div class="container py-5">
    <h2 class="mb-5 text-center text-primary">@ViewData["Title"]</h2>

    <form asp-action="Submit" method="post">
        @for (int i = 0; i < Model.Count; i++)
        {
            var question = Model[i];
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-primary text-white fw-bold">
                    Câu @(i + 1): @question.QuestionText
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var choice in question.Choices)
                        {
                            <div class="col-md-6">
                                <div class="form-check">
                                    <label class="form-check-label w-100 p-3 bg-light border rounded shadow-sm d-flex align-items-center hover-effect" style="cursor: pointer;">
                                        <input class="form-check-input me-3"
                                               type="radio"
                                               name="answers[@i].SelectedAnswer"
                                               value="@choice"
                                               required />
                                        <span class="flex-grow-1">@choice</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <input type="hidden" name="answers[@i].QuestionId" value="@question.Id" />
                </div>
            </div>
        }

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success btn-lg px-5 py-2 rounded-pill">✅ Nộp bài</button>
        </div>
    </form>
</div>

<style>
    .hover-effect:hover {
        background-color: #e6f7ff;
        border-color: #80bdff;
        box-shadow: 0 0 8px rgba(0, 123, 255, 0.25);
        transition: all 0.3s ease;
    }

    .form-check-input:checked + span {
        font-weight: bold;
        color: #0d6efd;
    }
</style>

@model SharedModels.Models.ViewModels.TestResultViewModel

@{
    ViewData["Title"] = "Kết quả bài kiểm tra đầu vào";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center">
                    <h3 class="mb-0">✅ Kết quả kiểm tra đầu vào</h3>
                </div>
                <div class="card-body text-center">
                    <p class="fs-5"><strong>Số câu đúng:</strong> <span class="text-primary">@Model.CorrectAnswers / @Model.TotalQuestions</span></p>
                    <p class="fs-5">
                        <strong>Trình độ gợi ý:</strong>
                        <span class="badge bg-primary fs-6 px-3 py-2">@Model.SuggestedLevel</span>
                    </p>

                    <hr class="my-4" />

                    <a asp-controller="Home"
                       asp-action="ChonLevel"
                       class="btn btn-outline-primary rounded-pill px-4 py-2">
                        🔙 Quay lại Chọn Level
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

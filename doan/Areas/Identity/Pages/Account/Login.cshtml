@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    .auth-bg {
        min-height: 100vh;
        background: radial-gradient(1200px 500px at -10% -10%, rgba(99,102,241,.10), transparent 60%), radial-gradient(1000px 400px at 110% 0%, rgba(16,185,129,.10), transparent 60%), linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border: 1px solid #eaeef3;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.06);
        overflow: hidden;
    }

        .auth-card .header {
            padding: 28px 28px 12px;
        }

        .auth-card .sub {
            color: #6b7280;
            font-size: 14px;
            margin-top: 4px;
        }

        .auth-card .body {
            padding: 0 28px 28px;
        }

    .form-floating > .form-control {
        border-radius: 12px;
    }

    .btn-primary {
        background: linear-gradient(90deg,#6366f1,#8b5cf6);
        border: none;
        border-radius: 12px;
        font-weight: 600;
        box-shadow: 0 6px 20px rgba(99,102,241,.3);
    }

    .divider {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        margin: 18px 0;
        color: #9ca3af;
        font-size: 12px;
        text-transform: uppercase;
    }

        .divider::before, .divider::after {
            content: "";
            height: 1px;
            background: #e5e7eb;
        }

    .btn-google {
        width: 100%;
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 12px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-weight: 600;
        box-shadow: 0 2px 10px rgba(17,24,39,.04);
    }

        .btn-google:hover {
            background: #fafafa;
        }
</style>

<div class="auth-bg">
    <div class="auth-card">
        <div class="header">
            <div class="sub">Đăng nhập để tiếp tục</div>
        </div>

        <div class="body">
            <!-- FORM LOGIN LOCAL -->
            <form id="account" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" placeholder="Mật khẩu" />
                    <label asp-for="Input.Password">Mật khẩu</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeChk" />
                        <label class="form-check-label" for="rememberMeChk">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <a asp-page="./ForgotPassword" class="small">Quên mật khẩu?</a>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2">Đăng nhập</button>
            </form>
            <!-- END LOCAL FORM -->

            <div class="divider">Hoặc</div>

            <!-- FORM GOOGLE -->
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <form id="external-login"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="~/"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" name="provider" value="Google" class="btn-google">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303C33.782 32.658 29.259 36 24 36c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.676 6.053 29.627 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20c10.493 0 19.12-8.027 19.12-20 0-1.341-.139-2.647-.409-3.917z" />
                            <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.357 16.14 18.83 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.676 6.053 29.627 4 24 4 16.318 4 9.656 8.337 6.306 14.691z" />
                            <path fill="#4CAF50" d="M24 44c5.176 0 9.86-1.977 13.377-5.197l-6.162-5.21C29.164 35.091 26.713 36 24 36c-5.241 0-9.748-3.317-11.289-7.946l-6.54 5.033C9.49 39.6 16.23 44 24 44z" />
                            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-1.177 3.658-4.7 6-9.303 6-5.241 0-9.748-3.317-11.289-7.946l-6.54 5.033C9.49 39.6 16.23 44 24 44c10.493 0 19.12-8.027 19.12-20 0-1.341-.139-2.647-.409-3.917z" />
                        </svg>
                        <span>Đăng nhập bằng Google</span>
                    </button>
                </form>
            }

            <div class="muted-links mt-3 text-center">
                <a asp-page="./Register">Đăng ký người dùng mới</a>
                <span class="mx-2">•</span>
                <a asp-page="./ResendEmailConfirmation">Gửi lại xác nhận email</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
}

<style>
    body {
        background: #f6f7fb;
    }

    .wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .card-auth {
        width: 100%;
        max-width: 760px;
        background: #fff;
        border: 1px solid #eceff3;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(16,24,40,.06);
        overflow: hidden;
    }

    .pane-right {
        padding: 24px;
    }

    .title {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
        text-align: center;
    }

    .sub {
        font-size: 13px;
        color: #6b7280;
        text-align: center;
        margin: 6px 0 18px;
    }

    .form-floating > .form-control {
        border-radius: 10px;
    }

    .pw-wrap {
        position: relative;
    }

    .pw-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        cursor: pointer;
        color: #6b7280;
    }

    .btn-primary {
        background: #4f46e5;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        box-shadow: 0 6px 18px rgba(79,70,229,.25);
    }

    .divider {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 10px;
        font-size: 12px;
        color: #9ca3af;
        margin: 16px 0;
    }

        .divider::before, .divider::after {
            content: "";
            height: 1px;
            background: #e5e7eb;
        }

    .btn-google {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px 12px;
        font-weight: 600;
    }

        .btn-google:hover {
            background: #fafafa;
        }
</style>

<div class="wrap">
    <div class="card-auth">
        <section class="pane-right">
            <h1 class="title">Tạo tài khoản</h1>
            <div class="sub">Điền thông tin hoặc dùng Google</div>

            <!-- Form Local -->
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Name" class="form-control" autocomplete="name" />
                    <label asp-for="Input.Name">Họ và tên</label>
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3 pw-wrap">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
                    <label asp-for="Input.Password">Mật khẩu</label>
                    <button type="button" class="pw-toggle" data-target="Input_Password">👁️</button>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3 pw-wrap">
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                    <button type="button" class="pw-toggle" data-target="Input_ConfirmPassword">👁️</button>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn btn-primary w-100">Tạo tài khoản</button>
            </form>

            <div class="divider">hoặc</div>

            <!-- Google Register -->
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <form asp-page="./ExternalLogin" asp-route-returnUrl="~/" asp-route-flow="register" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" name="provider" value="Google" class="btn-google">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.5 4.7-6 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.7 6.1 29.6 4 24 4 13 4 4 13 4 24s9 20 20 20c10.5 0 19.1-8 19.1-20 0-1.3-.1-2.6-.4-3.9z" />
                            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.4 16.1 18.8 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34.7 6.1 29.6 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-1.2 3.7-4.7 6-9.3 6-5.2 0-9.7-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44c10.5 0 19.1-8 19.1-20 0-1.3-.1-2.6-.4-3.9z" />
                        </svg>
                        <span>Đăng ký bằng Google</span>
                    </button>
                </form>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.pw-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-target');
                const input = document.getElementById(id);
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
            });
        });
    </script>
}

@model List<SharedModels.Models.TestQuestion>

@{
    ViewData["Title"] = "Danh sách câu hỏi test đầu vào";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-patch-question-fill me-2"></i> @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm mới
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive shadow-sm border rounded bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th>#</th>
                        <th>Câu hỏi</th>
                        <th>Chủ đề</th>
                        <th>Trình độ</th>
                        <th>Đáp án đúng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@q.Id</td>
                            <td class="text-start">@q.QuestionText</td>
                            <td>@q.Topic</td>
                            <td>@q.Level</td>
                            <td class="text-success fw-semibold">@q.CorrectAnswer</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1 flex-wrap">
                                    <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                        <i class="bi bi-info-circle"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@q.Id" class="btn btn-sm btn-outline-danger" title="Xoá" onclick="return confirm('Xác nhận xoá?')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-4">
            <i class="bi bi-exclamation-circle fs-4"></i> Không có câu hỏi nào.
        </div>
    }
</div>

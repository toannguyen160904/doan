@model SharedModels.Models.TestQuestion

@{
    ViewData["Title"] = "Tạo câu hỏi test đầu vào";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Câu hỏi</label>
        <input asp-for="QuestionText" class="form-control" />
    </div>

    <div class="form-group">
        <label>Đáp án đúng</label>
        <input asp-for="CorrectAnswer" class="form-control" />
    </div>

    <div class="form-group">
        <label>Chủ đề</label>
        <input asp-for="Topic" class="form-control" />
    </div>

    <div class="form-group">
        <label>Trình độ</label>
        <select asp-for="Level" class="form-control">
            <option value="N5">N5</option>
            <option value="N4">N4</option>
            <option value="N3">N3</option>
        </select>
    </div>

    <div class="form-group">
        <label>Lựa chọn đáp án</label>
        @for (int i = 0; i < 4; i++)
        {
            <input name="options[@i]" class="form-control mb-1" placeholder="Lựa chọn @(i + 1)" />
        }
    </div>

    <div class="form-group">
        <label>Giải thích (nếu có)</label>
        <textarea asp-for="Explanation" class="form-control"></textarea>
    </div>

    <input type="hidden" asp-for="Score" value="1" />
    <input type="hidden" asp-for="IsActive" value="true" />

    <button type="submit" class="btn btn-success">Lưu câu hỏi</button>
    <a asp-action="Index" class="btn btn-secondary">Danh sách</a>
</form>

@model doan.Models.TestQuestion

@{
    ViewData["Title"] = "Sửa câu hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Sửa câu hỏi</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Câu hỏi</label>
        <input asp-for="QuestionText" class="form-control" />
    </div>

    <div class="form-group">
        <label>Đáp án đúng</label>
        <input asp-for="CorrectAnswer" class="form-control" />
    </div>

    <div class="form-group">
        <label>Chủ đề</label>
        <input asp-for="Topic" class="form-control" />
    </div>

    <div class="form-group">
        <label>Trình độ</label>
        <select asp-for="Level" class="form-control">
            <option value="N5">N5</option>
            <option value="N4">N4</option>
            <option value="N3">N3</option>
        </select>
    </div>

    <div class="form-group">
        <label>Lựa chọn đáp án</label>
        @for (int i = 0; i < Model.Choices.Count; i++)
        {
            <input name="options" class="form-control mb-1" value="@Model.Choices[i]" />
        }
    </div>

    <div class="form-group">
        <label>Giải thích</label>
        <textarea asp-for="Explanation" class="form-control"></textarea>
    </div>

    <div class="form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label class="form-check-label">Kích hoạt</label>
    </div>

    <input type="hidden" asp-for="Score" />

    <button type="submit" class="btn btn-success">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Trở lại</a>
</form>

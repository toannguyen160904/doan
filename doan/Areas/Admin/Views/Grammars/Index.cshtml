@model IEnumerable<SharedModels.Models.GrammarStructure>

@{
    ViewData["Title"] = "Danh sách Ngữ pháp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <!-- Tiêu đề và nút thêm -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-success">
            <i class="bi bi-journal-text me-2"></i> @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm ngữ pháp
        </a>
    </div>

    <!-- BỘ LỌC -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="levelFilter" class="form-label fw-semibold">Lọc theo Cấp độ</label>
                    <select id="levelFilter" class="form-select" asp-items="ViewBag.Levels">
                        <option value="0" selected>-- Tất cả Cấp độ --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="lessonFilter" class="form-label fw-semibold">Lọc theo Bài học</label>
                    <select id="lessonFilter" class="form-select">
                        <option value="0" selected>-- Tất cả Bài học --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button id="resetFilter" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- VÙNG HIỂN THỊ DANH SÁCH (SẼ ĐƯỢC CẬP NHẬT BẰNG AJAX) -->
    <div id="grammarListContainer">
        @await Html.PartialAsync("_GrammarListPartial", Model)
    </div>

</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/js/grammar-management.js"></script>
}

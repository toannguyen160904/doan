@model doan.Models.GrammarStructure

@{
    ViewData["Title"] = "Thêm ngữ pháp mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i> Thêm ngữ pháp mới</h4>
        </div>

        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <form asp-action="Create" method="post">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Cấp độ <span class="text-danger">*</span></label>
                        <select id="levelSelect" class="form-select">
                            <option value="">-- Chọn cấp độ --</option>
                            @foreach (var level in (SelectList)ViewBag.Levels)
                            {
                                <option value="@level.Value">@level.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LessonId" class="form-label fw-semibold">Bài học <span class="text-danger">*</span></label>
                        <select id="lessonSelect" class="form-select">
                            <option value="">-- Chọn bài học --</option>
                        </select>
                        <input type="hidden" asp-for="LessonId" />
                        <span asp-validation-for="LessonId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="CongThuc" class="form-label fw-semibold">Cấu trúc ngữ pháp <span class="text-danger">*</span></label>
                        <input asp-for="CongThuc" class="form-control" placeholder="VD: ～ています" autocomplete="off" />
                        <span asp-validation-for="CongThuc" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="GiaiThich" class="form-label fw-semibold">Giải thích</label>
                        <textarea asp-for="GiaiThich" class="form-control" rows="2" placeholder="Giải thích chi tiết"></textarea>
                        <span asp-validation-for="GiaiThich" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="CauViDu" class="form-label fw-semibold">Câu ví dụ</label>
                        <textarea asp-for="CauViDu" class="form-control" rows="2" placeholder="Nhập ví dụ"></textarea>
                        <span asp-validation-for="CauViDu" class="text-danger small"></span>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
                    </a>

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save2-fill me-1"></i> Thêm ngữ pháp
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Load bài học theo cấp độ
        $("#levelSelect").change(function () {
            var levelId = $(this).val();
            $.get("/api/BaihocApi/GetByLevel/" + levelId, function (data) {
                var lessonSelect = $("#lessonSelect");
                lessonSelect.empty();
                lessonSelect.append('<option value="">-- Chọn bài học --</option>');
                $.each(data, function (i, lesson) {
                    lessonSelect.append(`<option value="${lesson.id}">${lesson.name}</option>`);
                });
                $("#LessonId").val("");
            });
        });

        $("#lessonSelect").change(function () {
            $("#LessonId").val($(this).val());
        });
    </script>
}

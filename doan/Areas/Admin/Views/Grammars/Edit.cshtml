@model doan.Models.GrammarStructure

@{
    ViewData["Title"] = "Sửa ngữ pháp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Sửa ngữ pháp</h4>
        </div>

        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Cấp độ <span class="text-danger">*</span></label>
                        <select id="levelSelect" class="form-select">
                            <option value="">-- Chọn cấp độ --</option>
                            @foreach (var level in (SelectList)ViewBag.Levels)
                            {
                                <option value="@level.Value">@level.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LessonId" class="form-label fw-semibold">Bài học <span class="text-danger">*</span></label>
                        <select id="lessonSelect" class="form-select"></select>
                        <input type="hidden" asp-for="LessonId" />
                        <span asp-validation-for="LessonId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CongThuc" class="form-label fw-semibold">Cấu trúc ngữ pháp <span class="text-danger">*</span></label>
                    <input asp-for="CongThuc" class="form-control" placeholder="Nhập cấu trúc ngữ pháp" />
                    <span asp-validation-for="CongThuc" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GiaiThich" class="form-label fw-semibold">Giải thích</label>
                    <textarea asp-for="GiaiThich" class="form-control" rows="2" placeholder="Nhập giải thích"></textarea>
                    <span asp-validation-for="GiaiThich" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CauViDu" class="form-label fw-semibold">Câu ví dụ</label>
                    <textarea asp-for="CauViDu" class="form-control" rows="2" placeholder="Nhập câu ví dụ"></textarea>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
                    </a>

                    <button type="submit" class="btn btn-warning text-white">
                        <i class="bi bi-save me-1"></i> Cập nhật
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var currentLessonId = '@Model.LessonId';

        $(document).ready(function () {

            // Tự load bài học của cấp độ hiện tại khi load form
            loadLessonsByLevel('@ViewBag.CurrentLevelId', currentLessonId);

            $('#levelSelect').val('@ViewBag.CurrentLevelId');

            $('#levelSelect').change(function () {
                var levelId = $(this).val();
                loadLessonsByLevel(levelId, "");
            });

            $('#lessonSelect').change(function () {
                $('#LessonId').val($(this).val());
            });
        });

        function loadLessonsByLevel(levelId, selectedLessonId) {
            if (levelId) {
                $.get('/api/BaihocApi/GetByLevel/' + levelId, function (data) {
                    var lessonSelect = $('#lessonSelect');
                    lessonSelect.empty();
                    lessonSelect.append('<option value="">-- Chọn bài học --</option>');

                    $.each(data, function (i, lesson) {
                        if (lesson.id == selectedLessonId) {
                            lessonSelect.append(`<option value="${lesson.id}" selected>${lesson.name}</option>`);
                        } else {
                            lessonSelect.append(`<option value="${lesson.id}">${lesson.name}</option>`);
                        }
                    });
                    $('#LessonId').val(selectedLessonId);
                });
            }
        }
    </script>
}

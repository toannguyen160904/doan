@model doan.Models.GrammarStructure

@{
    ViewData["Title"] = "Chi tiết ngữ pháp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-eye-fill me-2"></i> Chi tiết ngữ pháp</h4>
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3 fw-semibold">Cấp độ</dt>
                <dd class="col-sm-9">@Model.Lesson?.Level?.Name</dd>

                <dt class="col-sm-3 fw-semibold">Bài học</dt>
                <dd class="col-sm-9">@Model.Lesson?.Name</dd>

                <dt class="col-sm-3 fw-semibold">Cấu trúc ngữ pháp</dt>
                <dd class="col-sm-9">@Model.CongThuc</dd>

                <dt class="col-sm-3 fw-semibold">Giải thích</dt>
                <dd class="col-sm-9">@Model.GiaiThich</dd>

                <dt class="col-sm-3 fw-semibold">Câu ví dụ</dt>
                <dd class="col-sm-9">@Model.CauViDu</dd>

            </dl>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil-square me-1"></i> Sửa
                </a>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
                </a>
            </div>

        </div>
    </div>

</div>

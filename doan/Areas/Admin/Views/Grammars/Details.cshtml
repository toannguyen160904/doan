@model doan.Models.GrammarStructure

@{
    ViewData["Title"] = "Chi tiết ngữ pháp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>🔍 Chi tiết ngữ pháp</h2>
<hr />
<dl class="row">
    <dt class="col-sm-2">Bài học</dt>
    <dd class="col-sm-10">@Model.Lesson?.Name</dd>

    <dt class="col-sm-2">Cấu trúc</dt>
    <dd class="col-sm-10">@Model.CongThuc</dd>

    <dt class="col-sm-2">Giải thích</dt>
    <dd class="col-sm-10">@Model.GiaiThich</dd>

    <dt class="col-sm-2">Ví dụ</dt>
    <dd class="col-sm-10">@Model.CauViDu</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">✏️ Sửa</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại</a>
</div>

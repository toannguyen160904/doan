@model doan.Models.Baihoc
@{
    ViewData["Title"] = "Xoá Bài học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Xoá Bài học</h2>
<hr />
<div>
    <h4>Bạn có chắc muốn xoá bài học này?</h4>
    <dl class="row">
        <dt class="col-sm-2">Tên bài học</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Tiêu đề</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Cấp độ</dt>
        <dd class="col-sm-10">@Model.Level?.Name</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xoá</button>
    <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
</form>

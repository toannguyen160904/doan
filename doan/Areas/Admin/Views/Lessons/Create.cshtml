@model doan.Models.GrammarStructure

@{
    ViewData["Title"] = "Thêm ngữ pháp mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-3">Thêm ngữ pháp mới</h2>
<hr />

@* Hiển thị lỗi tổng thể *@
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@* Debug lỗi nếu cần thiết *@
@if (!ViewData.ModelState.IsValid)
{
    foreach (var key in ViewData.ModelState.Keys)
    {
        foreach (var error in ViewData.ModelState[key].Errors)
        {
            <div class="text-danger"><strong>@key:</strong> @error.ErrorMessage</div>
        }
    }
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="CongThuc" class="form-label">Cấu trúc ngữ pháp</label>
        <input asp-for="CongThuc" class="form-control" placeholder="VD: ～ている" autocomplete="off" />
        <span asp-validation-for="CongThuc" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="GiaiThich" class="form-label">Giải thích</label>
        <textarea asp-for="GiaiThich" class="form-control" placeholder="Giải thích ý nghĩa, cách dùng"></textarea>
        <span asp-validation-for="GiaiThich" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="CauViDu" class="form-label">Câu ví dụ</label>
        <textarea asp-for="CauViDu" class="form-control" placeholder="VD: わたしはべんきょうしています。"></textarea>
        <span asp-validation-for="CauViDu" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="LessonId" class="form-label">Bài học</label>
        <select asp-for="LessonId" class="form-control" asp-items="ViewBag.LessonList">
            <option value="">-- Chọn bài học --</option>
        </select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-3">➕ Thêm ngữ pháp</button>
    <a asp-action="Index" class="btn btn-secondary mt-3 ms-2">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

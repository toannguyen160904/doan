@model doan.Models.Baihoc

@{
    ViewData["Title"] = "Thêm bài học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-3">Thêm bài học mới</h2>
<hr />

@Html.ValidationSummary(false, "", new { @class = "text-danger" })

@if (!ViewData.ModelState.IsValid)
{
    foreach (var key in ViewData.ModelState.Keys)
    {
        foreach (var error in ViewData.ModelState[key].Errors)
        {
            <div class="text-danger"><strong>@key:</strong> @error.ErrorMessage</div>
        }
    }
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Name" class="form-label">Tên bài học</label>
        <input asp-for="Name" class="form-control" placeholder="Nhập tên bài học" autocomplete="off" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Title" class="form-label">Tiêu đề</label>
        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề bài học (hiển thị ngắn)" autocomplete="off" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="LevelId" class="form-label">Cấp độ</label>
        <select asp-for="LevelId" class="form-control" asp-items="ViewBag.Levels">
            <option value="">-- Chọn cấp độ --</option>
        </select>
        <span asp-validation-for="LevelId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-3">➕ Thêm bài học</button>
    <a asp-action="Index" class="btn btn-secondary mt-3 ms-2">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model doan.Models.Baihoc

@{
    ViewData["Title"] = "Chỉnh sửa Bài học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Bài học</h4>
                </div>

                <div class="card-body">

                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Tên bài học <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control shadow-sm" placeholder="Nhập tên bài học" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Tiêu đề <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control shadow-sm" placeholder="Nhập tiêu đề ngắn" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LevelId" class="form-label fw-semibold">Cấp độ <span class="text-danger">*</span></label>
                            <select asp-for="LevelId" class="form-select shadow-sm" asp-items="ViewBag.Levels">
                                <option value="">-- Chọn cấp độ --</option>
                            </select>
                            <span asp-validation-for="LevelId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Lưu lại
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

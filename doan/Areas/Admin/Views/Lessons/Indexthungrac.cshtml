@model List<SharedModels.Models.Baihoc>

@{
    ViewData["Title"] = "Thùng rác - Bài học đã xóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-danger fw-bold m-0">
            <i class="fa-solid fa-trash-can"></i> Thùng rác - Bài học đã xóa
        </h4>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Lessons" asp-action="Indexthungrac">
                <i class="bi bi-arrow-clockwise"></i> Tải lại
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-danger">
                        <tr>
                            <th class="text-start">📘 Tên bài học</th>
                            <th>📈 Cấp độ</th>
                            <th>⚙️ Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    <i class="fa-solid fa-box-open fa-2x mb-2"></i><br />
                                    Không có bài học nào trong thùng rác.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-start fw-semibold">@item.Name</td>
                                    <td>@item.Level?.Name</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                                            <a asp-action="Restore" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Khôi phục">
                                                <i class="fa-solid fa-arrow-rotate-left"></i> Khôi phục
                                            </a>
                                            <a asp-action="DeletePermanent" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Bạn có chắc muốn xóa vĩnh viễn bài học này không?');"
                                               title="Xóa vĩnh viễn">
                                                <i class="fa-solid fa-trash-can"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

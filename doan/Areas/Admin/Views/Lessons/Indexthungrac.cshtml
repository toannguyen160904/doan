@model List<doan.Models.Baihoc>

@{
    ViewData["Title"] = "Thùng rác - Bài học đã xóa";
}

<!-- FontAwesome (nếu chưa có, thêm vào layout) -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger mb-0">
            <i class="fas fa-trash-alt me-2"></i> Thùng rác - Bài học đã xóa
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th scope="col">📘 Tên bài học</th>
                            <th scope="col">📈 Level</th>
                            <th scope="col">⚙️ Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-2x mb-2"></i><br />
                                    Không có bài học nào trong thùng rác.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr id="lesson-@item.Id">
                                    <td>@item.Name</td>
                                    <td class="text-center">@item.Level?.Name</td>
                                    <td class="text-center">
                                        <a asp-action="Restore" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-success me-2">
                                            <i class="fas fa-rotate-left me-1"></i> Khôi phục
                                        </a>
                                        <a asp-action="DeletePermanent" asp-route-id="@item.Id"
                                           onclick="return confirm('Bạn có chắc muốn xóa vĩnh viễn bài học này không?');"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash me-1"></i> Xóa vĩnh viễn
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

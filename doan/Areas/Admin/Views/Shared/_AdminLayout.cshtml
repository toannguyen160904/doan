@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --bg-color: #f8f9fa;
            --text-color: #212529;
            --sidebar-bg: #212529;
            --sidebar-text: #adb5bd;
            --sidebar-hover: #343a40;
            --content-bg: #ffffff;
        }

        body.dark-mode {
            --bg-color: #1e1e2f;
            --text-color: #ffffff;
            --sidebar-bg: #12121d;
            --sidebar-text: #ccc;
            --sidebar-hover: #343a40;
            --content-bg: #2a2a3d;
        }

        body {
            background: var(--bg-color);
            color: var(--text-color);
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            left: 0;
            top: 0;
            transition: all 0.3s ease;
            z-index: 1000;
        }

            .sidebar.collapsed {
                left: -250px;
            }

            .sidebar h4 {
                color: #ffffff;
                text-align: center;
                margin-top: 20px;
            }

            .sidebar .nav-link {
                color: var(--sidebar-text);
                padding: 12px 20px;
                display: flex;
                align-items: center;
                gap: 10px;
                border-radius: 6px;
                transition: all 0.3s;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background-color: var(--sidebar-hover);
                    color: #fff;
                }

        .topbar {
            margin-left: 250px;
            background-color: var(--content-bg);
            padding: 15px 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

            .topbar.collapsed {
                margin-left: 0;
            }

        .main-content {
            margin-left: 250px;
            padding: 30px;
            transition: all 0.3s ease;
        }

            .main-content.collapsed {
                margin-left: 0;
            }

        .content {
            background-color: var(--content-bg);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
        }

        .btn-logout {
            border: none;
            border-radius: 6px;
            padding: 10px;
            transition: all 0.3s;
        }

            .btn-logout:hover {
                background-color: #bb2d3b !important;
            }

        /* media (max-width: 768px) { */
        /*     .sidebar */

        /* { */
        /*     left: -250px; */
        /* } */

        /* .main-content, */
        /* .topbar { */
        /*     margin-left: 0 !important; */
        /* } */

        /* } */

        /* .toggle-btn { */
        /*     font-size: 1.3rem; */
        /*     background: none; */
        /*     border: none; */
        /*     color: var(--text-color); */
        /* } */
    </style>
</head>

<body>
    <!-- Sidebar -->
    <div class="sidebar p-4" id="sidebar">
        <h4>🎓 Admin Panel</h4>
        <ul class="nav flex-column gap-2 mt-4">
            <li><a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
            <li><a class="nav-link" asp-area="Admin" asp-controller="Lessons" asp-action="Index"><i class="bi bi-book"></i> Bài học</a></li>
            <li><a class="nav-link" asp-area="Admin" asp-controller="Vocabularies" asp-action="Index"><i class="bi bi-journal-text"></i> Từ vựng</a></li>
            <li><a class="nav-link" asp-area="Admin" asp-controller="Grammars" asp-action="Index"><i class="bi bi-pencil-square"></i> Ngữ pháp</a></li>
            <li><a class="nav-link" asp-area="Admin" asp-controller="TestQuestion" asp-action="Index"><i class="bi bi-patch-question"></i> Câu hỏi test</a></li>
            <li><a class="nav-link text-danger" asp-area="Admin" asp-controller="Lessons" asp-action="Indexthungrac">🗑️ Thùng rác bài học</a></li>
            <li class="mt-3"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Trang chính</a></li>
        </ul>
    </div>

    <!-- Topbar -->
    <div class="topbar" id="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="toggle-btn" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
            <strong>@ViewData["Title"]</strong>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span><i class="bi bi-person-circle me-1"></i> @user?.UserName</span>
            <button class="btn btn-outline-secondary btn-sm" onclick="toggleDarkMode()" title="Chuyển chế độ nền">
                <i class="bi bi-moon-stars" id="dark-icon"></i>
            </button>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="mb-0">
                <button class="btn btn-danger btn-logout"><i class="bi bi-box-arrow-right"></i></button>
            </form>
        </div>
    </div>

    <!-- Main content -->
    <div class="main-content" id="main">
        <div class="content">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Giao diện tối/sáng
        function toggleDarkMode() {
            document.body.classList.toggle("dark-mode");
            const isDark = document.body.classList.contains("dark-mode");
            localStorage.setItem("darkMode", isDark);
            document.getElementById("dark-icon").className = isDark ? "bi bi-sun-fill" : "bi bi-moon-stars";
        }

        // Giao diện khi tải lại trang
        window.onload = function () {
            const darkMode = localStorage.getItem("darkMode") === "true";
            if (darkMode) {
                document.body.classList.add("dark-mode");
                document.getElementById("dark-icon").className = "bi bi-sun-fill";
            }
        }

        // Mở / đóng sidebar
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('collapsed');
            document.getElementById('topbar').classList.toggle('collapsed');
            document.getElementById('main').classList.toggle('collapsed');
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kiểm Tra Trình Độ</title>

    <!-- Thư viện CSS nền tảng -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS tùy chỉnh của trang (nếu có) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Nơi để các file view con có thể thêm CSS nếu cần *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- =================== SCRIPTS NỀN TẢNG =================== -->
    <!-- jQuery (thường cần cho nhiều plugin và AJAX) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap Bundle (bao gồm Popper.js, cần cho các component tương tác) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script tùy chỉnh của toàn bộ site (nếu có) -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Nơi để render các script từ file view con (như test-ui.js và test-handler.js) *@
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
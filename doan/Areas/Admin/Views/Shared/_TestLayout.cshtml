<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Kiểm tra</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(145deg, #e0f2fe, #f0f9ff);
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        .test-wrapper {
            max-width: 860px;
            margin: 60px auto;
            padding: 40px;
            background-color: #ffffff;
            border-radius: 28px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            position: relative;
        }

        h2.title {
            font-size: 28px;
            font-weight: 700;
            color: #2563eb;
            text-align: center;
            margin-bottom: 30px;
        }

        .question-box {
            background-color: #f9fafb;
            border-radius: 16px;
            padding: 20px 25px;
            margin-bottom: 24px;
            border-left: 6px solid #38bdf8;
            transition: transform 0.2s ease;
        }

            .question-box:hover {
                transform: translateY(-3px);
                background-color: #e0f2fe;
            }

        .form-check {
            padding: 10px 15px;
            margin-bottom: 10px;
            border-radius: 12px;
            background-color: #fff;
            border: 1px solid #e5e7eb;
            transition: all 0.2s ease;
        }

            .form-check:hover {
                background-color: #f0f9ff;
            }

        .form-check-input:checked {
            background-color: #38bdf8;
            border-color: #38bdf8;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
        }

            .form-check-input:checked + label {
                font-weight: bold;
                color: #0ea5e9;
            }

        .btn-submit {
            background-color: #38bdf8;
            color: white;
            font-weight: 600;
            padding: 12px 28px;
            border-radius: 25px;
            border: none;
            display: block;
            margin: 30px auto 0;
            transition: 0.3s ease;
        }

            .btn-submit:hover {
                background-color: #0ea5e9;
                transform: scale(1.05);
            }

        .cute-icon {
            width: 70px;
            position: absolute;
            top: -40px;
            right: -20px;
        }

        {
            padding: 20px;
            margin: 20px;
        }

        .cute-icon {
            width: 50px;
            top: -30px;
            right: -10px;
        }

        }
    </style>
</head>
<body>
    <div class="test-wrapper">
        <img src="https://cdn-icons-png.flaticon.com/512/167/167707.png" class="cute-icon" alt="icon" />
        <h2 class="title"><i class="fas fa-graduation-cap"></i> @ViewData["Title"]</h2>

        @RenderBody()
    </div>

    <script>
        // Hiệu ứng màu khi chọn radio
        document.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.form-check').forEach(el => {
                    el.style.backgroundColor = '#fff';
                });
                if (radio.checked) {
                    radio.closest('.form-check').style.backgroundColor = '#e0f2fe';
                }
            });
        });
    </script>
</body>
</html>

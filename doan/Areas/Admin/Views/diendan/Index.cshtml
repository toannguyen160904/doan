@model IEnumerable<SharedModels.Models.Diendanmodel>

@{
    ViewData["Title"] = "Quản lý Diễn đàn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* 
    Chúng ta sẽ sử dụng Card của Bootstrap để tạo một khung chứa gọn gàng.
    Card-header cho tiêu đề và Card-body cho nội dung chính (bảng).
*@
<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h3 class="mb-0">
            <i class="bi bi-chat-square-dots-fill me-2 text-primary"></i>
            @ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <div>
                    @TempData["SuccessMessage"]
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 20%;">Tiêu đề</th>
                        <th scope="col" style="width: 35%;">Nội dung</th>
                        <th scope="col" style="width: 15%;">Người đăng</th>
                        <th scope="col" style="width: 15%;">Bài học</th>
                        <th scope="col" class="text-center" style="width: 10%;">Ngày đăng</th>
                        <th scope="col" class="text-center" style="width: 5%;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var post in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@post.TieuDe</td>
                                <td>
                                    @* Giới hạn nội dung dài để không làm vỡ layout *@
                                    <span class="d-inline-block text-truncate" style="max-width: 400px;">
                                        @post.NoiDung
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-75">
                                        <i class="bi bi-person-fill"></i> @(post.User.Name )
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        <i class="bi bi-book"></i> @(post.Baihoc?.Name ?? "N/A")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <small class="text-muted">@post.CreatedAt.ToString("dd/MM/yy HH:mm")</small>
                                </td>
                                <td class="text-center">
                                    <form asp-action="DeletePost" asp-controller="Forum" asp-area="Admin" method="post"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không? Hành động này không thể hoàn tác.');">
                                        <input type="hidden" name="id" value="@post.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa bài viết">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center p-4">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                <span class="text-muted">Không có bài viết nào để hiển thị.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
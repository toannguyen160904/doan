@model SharedModels.Models.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mt-3">@ViewData["Title"]</h2>
<hr />

@if (Model != null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tên danh mục</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                @* Nếu có trường CreatedAt *@
                @* <dt class="col-sm-3">Ngày tạo</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd> *@
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại</a>
    </div>
}
else
{
    <div class="alert alert-danger">
        Không tìm thấy thông tin danh mục.
    </div>
    <a asp-action="Index" class="btn btn-secondary">⬅ Về danh sách</a>
}

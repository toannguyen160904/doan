@model doan.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mt-3 text-danger">@ViewData["Title"]</h2>
<hr />

@if (Model != null)
{
    <div class="alert alert-warning">
        <strong>Bạn có chắc chắn muốn xóa danh mục này?</strong>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tên danh mục</dt>
                <dd class="col-sm-9">@Model.Name</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">🗑 Xóa</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại</a>
    </form>
}
else
{
    <div class="alert alert-danger">
        Không tìm thấy danh mục cần xóa.
    </div>
    <a asp-action="Index" class="btn btn-secondary">⬅ Về danh sách</a>
}

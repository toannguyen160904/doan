@model SharedModels.Models.Category

@{
    ViewData["Title"] = "Tạo danh mục từ vựng/ngữ pháp";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

}

<div class="container mt-4">
    <h2 class="mb-4">📚 Tạo danh mục mới</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục (ví dụ: N5 - Chào hỏi)" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        ✅ Tạo danh mục
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

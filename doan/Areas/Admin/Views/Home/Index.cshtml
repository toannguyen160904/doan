@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row text-white">
    <div class="col-md-3 mb-4">
        <div class="bg-primary rounded p-4 shadow">
            <h5><i class="bi bi-people-fill me-2"></i> Người dùng</h5>
            <h3>@ViewBag.Users</h3>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="bg-success rounded p-4 shadow">
            <h5><i class="bi bi-book me-2"></i> Bài học</h5>
            <h3>@ViewBag.Lessons</h3>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="bg-info rounded p-4 shadow">
            <h5><i class="bi bi-journal-text me-2"></i> Từ vựng</h5>
            <h3>@ViewBag.Vocabularies</h3>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="bg-warning rounded p-4 shadow">
            <h5><i class="bi bi-pencil-square me-2"></i> Ngữ pháp</h5>
            <h3>@ViewBag.Grammars</h3>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="bg-danger rounded p-4 shadow">
            <h5><i class="bi bi-patch-question me-2"></i> Câu hỏi</h5>
            <h3>@ViewBag.Questions</h3>
        </div>
    </div>
</div>

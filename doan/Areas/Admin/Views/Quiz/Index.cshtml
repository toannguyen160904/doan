@model IEnumerable<doan.Models.Baihoc>

@{
    ViewData["Title"] = "Quản lý bài học & Quiz";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .table th, .table td {
        vertical-align: middle;
    }

    .btn-icon {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .action-buttons .btn {
        margin: 0 2px;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient bg-success text-white text-center py-3">
            <h4 class="mb-0"><i class="bi bi-journal-text me-2"></i> @ViewData["Title"]</h4>
        </div>

        <div class="card-body">
            <div class="text-end mb-3">
                @* Uncomment if you want to allow adding lessons *@
                @* <a asp-controller="Baihoc" asp-action="Create" class="btn btn-success shadow-sm">
                    <i class="bi bi-plus-circle"></i> Thêm bài học mới
                </a> *@
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-success">
                        <tr>
                            <th>Tên bài học</th>
                            <th>Tiêu đề</th>
                            <th>Cấp độ</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-start fw-semibold">@item.Name</td>
                                <td class="text-start">@item.Title</td>
                                <td>@item.LevelId</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex justify-content-center flex-wrap gap-1 action-buttons">
                                        @if (item.Quiz == null)
                                        {
                                            <a asp-action="CreateQuiz" asp-route-baiHocId="@item.Id" class="btn btn-sm btn-outline-success btn-icon" data-bs-toggle="tooltip" title="Thêm Quiz">
                                                <i class="bi bi-plus-circle-fill"></i> Quiz
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Quiz.Id" class="btn btn-sm btn-outline-primary btn-icon" data-bs-toggle="tooltip" title="Sửa Quiz">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Quiz.Id" class="btn btn-sm btn-outline-danger btn-icon" data-bs-toggle="tooltip" title="Xoá Quiz" onclick="return confirm('Bạn có muốn xóa bài Quiz?');">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Kích hoạt tooltip Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}

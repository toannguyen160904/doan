@model doan.Models.Vocabulary

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Chỉnh sửa từ vựng</h5>
            <a asp-action="Index" class="text-white text-decoration-none">
                <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
            </a>
        </div>

        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger text-sm text-center" })

            <form asp-action="Edit" id="editForm" novalidate>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LessonId" class="form-label">Bài học *</label>
                        <select asp-for="LessonId" asp-items="ViewBag.LessonId" class="form-select"></select>
                        <span asp-validation-for="LessonId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Tuvung" class="form-label">Từ vựng *</label>
                        <input asp-for="Tuvung" class="form-control" placeholder="Nhập từ vựng" />
                        <span asp-validation-for="Tuvung" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhatAm" class="form-label">Phát âm</label>
                        <input asp-for="PhatAm" class="form-control" placeholder="Nhập phát âm" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AmHan" class="form-label">Âm Hán</label>
                        <input asp-for="AmHan" class="form-control" placeholder="Nhập âm Hán" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HanTu" class="form-label">Hán Tự</label>
                        <input asp-for="HanTu" class="form-control" placeholder="Nhập Hán Tự" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Nghia" class="form-label">Nghĩa *</label>
                        <textarea asp-for="Nghia" rows="3" class="form-control" placeholder="Nhập nghĩa chi tiết"></textarea>
                        <span asp-validation-for="Nghia" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-end mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save2 me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const form = document.getElementById('editForm');
        form.addEventListener('submit', function () {
            const btn = form.querySelector('button[type="submit"]');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';
            btn.disabled = true;
        });
    </script>
}

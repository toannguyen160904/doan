@model doan.Models.Vocabulary

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle-fill"></i> Thêm từ vựng mới</h4>
        </div>

<form asp-action="Create" method="post">
    <!-- Chọn cấp độ -->
    <div class="form-group">
        <label>Cấp độ</label>
        <select id="levelSelect" class="form-control">
            <option value="">-- Chọn cấp độ --</option>
            @if (ViewBag.Levels != null)
            {
                foreach (var level in (SelectList)ViewBag.Levels)
                {
                    <option value="@level.Value">@level.Text</option>
                }
            }
            else
            {
                <option disabled>⚠ Không tải được danh sách cấp độ</option>
            }
        </select>
    </div>

    <!-- Chọn bài học (đã fix) -->
    <div class="form-group">
        <label asp-for="LessonId">Bài học</label>
        <select asp-for="LessonId" class="form-control" id="lessonSelect">
            <option value="">-- Chọn bài học --</option>
        </select>
        <span asp-validation-for="LessonId" class="text-danger"></span>
    </div>

    <!-- Các trường thông tin từ vựng -->
    <div class="form-group">
        <label asp-for="Tuvung"> Từ Vựng </label>
        <input asp-for="Tuvung" class="form-control" />
        <span asp-validation-for="Tuvung" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PhatAm"> Phát Âm</label>
        <input asp-for="PhatAm" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="AmHan">Âm Hán</label>
        <input asp-for="AmHan" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="HanTu">Hán Tự</label>
        <input asp-for="HanTu" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Nghia">Nghĩa</label>
        <textarea asp-for="Nghia" class="form-control"></textarea>
        <span asp-validation-for="Nghia" class="text-danger"></span>
    </div>

    <!-- Nút hành động -->
    <button type="submit" class="btn btn-success">Lưu từ vựng</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Khi chọn cấp độ → gọi API lấy danh sách bài học
        $("#levelSelect").change(function () {
            var levelId = $(this).val();
            $.get("/api/BaihocApi/GetByLevel/" + levelId, function (data) {
                var lessonSelect = $("#lessonSelect");
                lessonSelect.empty();
                lessonSelect.append('<option value="">-- Chọn bài học --</option>');
                $.each(data, function (i, lesson) {
                    lessonSelect.append(`<option value="${lesson.id}">${lesson.name}</option>`);
                });
            });
        });
    </script>

    <script src="~/js/them-tu-vung.js"></script>

}

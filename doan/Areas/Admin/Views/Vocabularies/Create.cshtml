@model SharedModels.Models.Vocabulary

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-plus-circle-fill me-2"></i> Thêm từ vựng mới</h4>
            <a asp-action="Index" class="text-white text-decoration-none">
                <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
            </a>
        </div>

        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <form asp-action="Create" method="post" id="createForm">
                <div class="row g-3">
                    <!-- Chọn cấp độ -->
                    <div class="col-md-6">
                        <label class="form-label">Cấp độ *</label>
                        <select id="levelSelect" class="form-select">
                            <option value="">-- Chọn cấp độ --</option>
                            @if (ViewBag.Levels != null)
                            {
                                foreach (var level in (SelectList)ViewBag.Levels)
                                {
                                    <option value="@level.Value">@level.Text</option>
                                }
                            }
                            else
                            {
                                <option disabled>⚠ Không tải được danh sách cấp độ</option>
                            }
                        </select>
                    </div>

                    <!-- Chọn bài học -->
                    <div class="col-md-6">
                        <label asp-for="LessonId" class="form-label">Bài học *</label>
                        <select asp-for="LessonId" class="form-select" id="lessonSelect">
                            <option value="">-- Chọn bài học --</option>
                        </select>
                        <span asp-validation-for="LessonId" class="text-danger small"></span>
                    </div>

                    <!-- Các trường từ vựng -->
                    <div class="col-md-6">
                        <label asp-for="Tuvung" class="form-label">Từ Vựng *</label>
                        <input asp-for="Tuvung" class="form-control" />
                        <span asp-validation-for="Tuvung" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhatAm" class="form-label">Phát Âm</label>
                        <input asp-for="PhatAm" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AmHan" class="form-label">Âm Hán</label>
                        <input asp-for="AmHan" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HanTu" class="form-label">Hán Tự</label>
                        <input asp-for="HanTu" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Nghia" class="form-label">Nghĩa *</label>
                        <textarea asp-for="Nghia" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Nghia" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Nút hành động -->
                <div class="mt-4 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i> Lưu từ vựng
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Khi chọn cấp độ → gọi API lấy danh sách bài học
        $("#levelSelect").change(function () {
            var levelId = $(this).val();
            $.get("/api/BaihocApi/GetByLevel/" + levelId, function (data) {
                var lessonSelect = $("#lessonSelect");
                lessonSelect.empty();
                lessonSelect.append('<option value="">-- Chọn bài học --</option>');
                $.each(data, function (i, lesson) {
                    lessonSelect.append(`<option value="${lesson.id}">${lesson.name}</option>`);
                });
            });
        });
    </script>

    <script src="~/js/them-tu-vung.js"></script>

}

@model doan.Models.Vocabulary

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <!-- Header -->
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-eye-fill me-2"></i> Chi tiết từ vựng</h4>
        </div>

        <!-- Nội dung -->
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 text-muted">Từ vựng:</dt>
                <dd class="col-sm-9 fw-bold">@Model.Tuvung</dd>

                <dt class="col-sm-3 text-muted">Phát âm:</dt>
                <dd class="col-sm-9">@Model.PhatAm</dd>

                <dt class="col-sm-3 text-muted">Âm Hán:</dt>
                <dd class="col-sm-9">@Model.AmHan</dd>

                <dt class="col-sm-3 text-muted">Hán Tự:</dt>
                <dd class="col-sm-9">@Model.HanTu</dd>

                <dt class="col-sm-3 text-muted">Nghĩa:</dt>
                <dd class="col-sm-9">@Model.Nghia</dd>

                <dt class="col-sm-3 text-muted">Thuộc bài học:</dt>
                <dd class="col-sm-9">@Model.Lesson?.Title</dd>
            </dl>
        </div>

        <!-- Footer -->
        <div class="card-footer bg-light text-end">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="bi bi-pencil-fill me-1"></i> Sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

</div>

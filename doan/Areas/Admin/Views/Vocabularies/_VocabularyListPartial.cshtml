@model IEnumerable<doan.Models.Vocabulary>

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-primary fw-bold">@item.Tuvung</h5>
                            <p class="mb-1"><strong>Phát âm:</strong> @item.PhatAm</p>
                            <p class="mb-1"><strong>Âm Hán:</strong> @item.AmHan</p>
                            <p class="mb-1"><strong>Hán tự:</strong> @item.HanTu</p>
                            <p class="mb-1"><strong>Nghĩa:</strong> @item.Nghia</p>
                            <p class="mb-0 text-muted"><strong>Bài học:</strong> @item.Lesson?.Name</p>
                        </div>
                        <div class="mt-3 d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Xác nhận xoá?')">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning text-center mt-4">
        <i class="bi bi-exclamation-circle fs-5"></i> Không có từ vựng nào.
    </div>
}

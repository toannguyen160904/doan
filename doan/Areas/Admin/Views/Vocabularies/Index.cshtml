@model IEnumerable<SharedModels.Models.Vocabulary>

@{
    ViewData["Title"] = "Từ vựng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <!-- Tiêu đề và nút Thêm -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-success m-0">
            <i class="bi bi-journal-bookmark-fill"></i> @ViewData["Title"]
        </h2>
        <a class="btn btn-success" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Thêm từ vựng
        </a>
    </div>

    <!-- Bộ lọc -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="levelFilter" class="form-label fw-semibold">Lọc theo Cấp độ</label>
                    <select id="levelFilter" class="form-select" asp-items="ViewBag.Levels">
                        <option value="0" selected>-- Tất cả Cấp độ --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="lessonFilter" class="form-label fw-semibold">Lọc theo Bài học</label>
                    <select id="lessonFilter" class="form-select">
                        <option value="0" selected>-- Tất cả Bài học --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button id="resetFilter" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách từ vựng -->
    <div id="vocabularyListContainer">
        @await Html.PartialAsync("_VocabularyListPartial", Model)
    </div>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/js/vocabulary-management.js"></script>
}

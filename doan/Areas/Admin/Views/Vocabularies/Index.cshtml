@model IEnumerable<doan.Models.Vocabulary>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-success m-0">
            <i class="bi bi-journal-bookmark-fill"></i> Từ vựng
        </h2>
        <a class="btn btn-success" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Thêm từ vựng
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-primary fw-bold">@item.Tuvung</h5>
                            <p class="mb-1"><strong>Phát âm:</strong> @item.PhatAm</p>
                            <p class="mb-1"><strong>Âm Hán:</strong> @item.AmHan</p>
                            <p class="mb-1"><strong>Hán tự:</strong> @item.HanTu</p>
                            <p class="mb-1"><strong>Nghĩa:</strong> @item.Nghia</p>
                            <p class="mb-0"><strong>Bài học:</strong> @item.Lesson?.Title</p>
                        </div>

                        <div class="mt-3 d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Xác nhận xoá?')">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

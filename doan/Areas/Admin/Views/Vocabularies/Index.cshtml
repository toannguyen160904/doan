@model IEnumerable<doan.Models.Vocabulary>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-2">
        <h2 class="text-primary fw-bold m-0">
            <i class="bi bi-book"></i> Danh sách từ vựng
        </h2>
        <a class="btn btn-success shadow-sm" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Thêm từ vựng
        </a>
    </div>

    <div class="table-responsive shadow-sm border rounded overflow-auto">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th scope="col">Từ vựng</th>
                    <th scope="col">Phát âm</th>
                    <th scope="col">Âm Hán</th>
                    <th scope="col">Hán tự</th>
                    <th scope="col" style="min-width: 120px;">Nghĩa</th>
                    <th scope="col">Bài học</th>
                    <th scope="col">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="text-center">
                        <td class="fw-semibold">@item.Tuvung</td>
                        <td>@item.PhatAm</td>
                        <td>@item.AmHan</td>
                        <td>@item.HanTu</td>
                        <td class="text-wrap" style="max-width:150px">@item.Nghia</td>
                        <td>@item.Lesson?.Title</td>
                        <td>
                            <div class="d-flex justify-content-center flex-wrap gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Chi tiết">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Xoá" onclick="return confirm('Xác nhận xoá?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

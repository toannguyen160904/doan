@model doan.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa tài liệu học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-3 text-primary">✏️ @ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">📘 Tên tài liệu</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="form-label">💴 Giá</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label">📝 Mô tả nội dung</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="form-label">📂 Danh mục</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">🖼 Ảnh minh họa mới</label>
                <input type="file" name="imageFile" class="form-control" />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mt-2">
                        <p class="text-muted">Ảnh hiện tại:</p>
                        <img src="@Model.ImageUrl" alt="Ảnh hiện tại" style="width: 120px;" class="img-thumbnail" />
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

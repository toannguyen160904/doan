@model IEnumerable<doan.Models.Product>

@{
    ViewData["Title"] = "📚 Tài liệu học tiếng Nhật";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-3 text-primary">📚 Danh sách tài liệu học tiếng Nhật</h2>

<p>
    <a asp-action="Create" class="btn btn-success mb-3">+ Thêm tài liệu mới</a>
</p>

<table id="example" class="table table-bordered table-hover">
    <thead class="table-info">
        <tr>
            <th>📘 Tên tài liệu</th>
            <th>💴 Giá</th>
            <th>📝 Mô tả</th>
            <th>🖼 Ảnh bìa</th>
            <th>🔧 Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var product in Model)
            {
                <tr>
                    <td><strong>@product.Name</strong></td>
                    <td>@string.Format("{0:N0}₫", product.Price)</td>
                    <td>@product.Description</td>
                    <td>
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="Ảnh tài liệu" class="img-thumbnail" style="width: 100px;" />
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Không có ảnh</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-info">Xem</a>
                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Chưa có tài liệu nào được thêm.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <!-- Yêu cầu bạn đã thêm thư viện DataTables -->
    <script>
        new DataTable('#example');
    </script>
}

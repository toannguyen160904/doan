# ---------- Stage 1: Build ----------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy đúng thư mục (chú ý chữ hoa/thường, Linux phân biệt)
COPY SharedModels/ SharedModels/
COPY doanapi/ doanapi/

# Restore + Publish project API
RUN dotnet restore doanapi/doanapi.csproj
RUN dotnet publish doanapi/doanapi.csproj -c Release -o /app/out /p:UseAppHost=false

# ---------- Stage 2: Runtime ----------
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Copy output đã publish từ stage build
COPY --from=build /app/out ./

# Railway inject PORT -> lắng nghe 0.0.0.0:PORT
ENV ASPNETCORE_URLS=http://0.0.0.0:${PORT}
# Tuỳ chọn: fallback local
ENV PORT=8080
EXPOSE 8080

# Nếu AssemblyName khác "doanapi", đổi dòng dưới cho khớp tên DLL bạn build ra
ENTRYPOINT ["dotnet", "doanapi.dll"]
